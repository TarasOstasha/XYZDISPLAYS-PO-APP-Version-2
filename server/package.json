{
  "name": "server",
  "version": "1.0.0",
  "description": "",
  "private": true,
  "main": "main.js",
  "dependencies": {
    "axios": "^1.6.7",
    "basic-ftp": "^5.0.5",
    "child_process": "^1.0.2",
    "clipboardy": "^4.0.0",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "exceljs": "^4.4.0",
    "express": "^4.18.2",
    "http-errors": "^2.0.0",
    "lodash": "^4.17.21",
    "node-outlook": "^1.1.8",
    "nodemailer": "^6.9.11",
    "nodemon": "^3.0.3",
    "pg": "^8.12.0",
    "pg-hstore": "^2.3.4",
    "sequelize": "^6.37.3",
    "xlsx": "^0.18.5",
    "xml2js": "^0.6.2"
  },
  "devDependencies": {
    "electron": "^31.0.0",
    "electron-builder": "^24.13.3",
    "electron-updater": "^6.1.8"
  },
  "scripts": {
    "server": "nodemon index",
    "dev": "nodemon -r dotenv/config .",
    "react:build": "cd ../client && npm run build",
    "electron:start": "electron .",
    "electron:pack": "npm run react:build && electron-builder --dir",
    "electron:build": "npm run react:build && electron-builder",
    "package-app": "npm run react:build && npm run electron:build"
  },
  "build": {
    "appId": "com.xyzdisplays.localapp",
    "productName": "xyzDisplays Local App",
    "directories": {
      "output": "dist"
    },
    "win": {
      "target": "portable",
      "artifactName": "xyzDisplays-${version}-Portable.${ext}"
    },
    "files": [
      "main.js",
      "preload.js",
      "index.js",
      "app.js",
      "package.json",
      "node_modules/**/*",
      "routes/**/*",
      "controllers/**/*",
      "middleware/**/*",
      "models/**/*",
      "services/**/*",
      "config/**/*",
      "utils/**/*",
      "../client/build/**/*",
      "!node_modules/*/{CHANGELOG.md,README.md,README,readme.md,readme}",
      "!node_modules/*/{test,__tests__,tests,powered-test,example,examples}",
      "!node_modules/*.d.ts",
      "!node_modules/.bin",
      "!**/*.{iml,o,hprof,orig,pyc,pyo,rbc,swp,csproj,sln,xproj}",
      "!.editorconfig",
      "!**/._*",
      "!**/{.DS_Store,.git,.hg,.svn,CVS,RCS,SCCS,.gitignore,.gitattributes}",
      "!**/{__pycache__,thumbs.db,.flowconfig,.idea,.vs,.nyc_output}",
      "!**/{appveyor.yml,.travis.yml,circle.yml}",
      "!**/{npm-debug.log,yarn.lock,.yarn-integrity,.yarn-metadata.json}"
    ],
    "extraResources": [
      {
        "from": "../client/build",
        "to": "client/build",
        "filter": ["**/*"]
      }
    ],
    "asar": true,
    "nsis": {
      "oneClick": true,
      "perMachine": false,
      "allowToChangeInstallationDirectory": false,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true
    },
    "publish": [
      { "provider": "generic", "url": "https://your-updates-server.example.com/" }
    ]
  },
  "author": "",
  "license": "ISC"
}
